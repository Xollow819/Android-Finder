+
+/* A background check only reads storage information. It never resets USB. */
+int ANDROIDFINDER_Probe_Storage(LIBMTP_raw_device_t *device)
+{
+  PTPParams params = {0};
+  PTPStorageIDs ids = {0};
+  PTP_USB *usb;
+  void *usbinfo = NULL;
+  int result = -1;
+  params.device_flags = device->device_entry.device_flags;
+#if defined(HAVE_ICONV) && defined(HAVE_LANGINFO_H)
+  params.cd_ucs2_to_locale = iconv_open("UTF-8", "UTF-16LE");
+  params.cd_locale_to_ucs2 = iconv_open("UTF-16LE", "UTF-8");
+#endif
+  if (configure_usb_session(device, &params, &usbinfo, &result) == LIBMTP_ERROR_NONE) {
+    usb = (PTP_USB *) usbinfo;
+    usb->params = &params;
+    if (ptp_getstorageids(&params, &ids) == PTP_RC_OK) {
+      for (uint32_t i = 0; i < ids.n; i++) {
+        PTPStorageInfo info = {0};
+        if (ptp_getstorageinfo(&params, ids.Storage[i], &info) == PTP_RC_OK)
+          result = 1;
+        free(info.StorageDescription);
+        free(info.VolumeLabel);
+        if (result == 1)
+          break;
+      }
+    }
+    ptp_closesession(&params);
+    close_usb(usb);
+    free(usb);
+  }
+  free(ids.Storage);
+  ptp_free_params(&params);
+#if defined(HAVE_ICONV) && defined(HAVE_LANGINFO_H)
+  if (params.cd_ucs2_to_locale != (iconv_t) -1)
+    iconv_close(params.cd_ucs2_to_locale);
+  if (params.cd_locale_to_ucs2 != (iconv_t) -1)
+    iconv_close(params.cd_locale_to_ucs2);
+#endif
+  return result;
+}
