<?xml version="1.0" encoding="UTF-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Android Finder</title>
    <options customize="never" hostArchitectures="arm64"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="androidfinder"/>
    </choices-outline>
    <choice id="androidfinder" visible="false">
        <pkg-ref id="local.androidfinder"/>
    </choice>
    <pkg-ref id="local.androidfinder" version="0.1.0">AndroidFinder-component.pkg</pkg-ref>
</installer-gui-script>
