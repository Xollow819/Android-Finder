#!/bin/sh
set -eu

[ "${3:-/}" = / ] || exit 0
uid=$(/usr/bin/stat -f '%u' /dev/console)
[ "$uid" -ge 501 ] || exit 0
domain="gui/$uid"
label=local.androidfinder.native
plist="/Library/LaunchAgents/$label.plist"
binary=$(/usr/bin/plutil -extract ProgramArguments.0 raw "$plist")
app="${binary%/Contents/MacOS/AndroidFinder}"
legacy='/Applications/I2407.app'
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

as_console_user() {
    /bin/launchctl asuser "$uid" /usr/bin/sudo -u "#$uid" "$@"
}

if /bin/launchctl print "$domain/$label" >/dev/null 2>&1; then
    /bin/launchctl bootout "$domain/$label" || :
fi
/usr/bin/pkill -TERM -u "$uid" -f '^/Applications/(Android Finder|I2407)[.]app/Contents/MacOS/AndroidFinder$' || :

# Move aside only the bundle owned by earlier versions of this package.
if [ "$app" != "$legacy" ] && [ -d "$legacy" ] &&
   [ "$(/usr/bin/plutil -extract CFBundleIdentifier raw "$legacy/Contents/Info.plist" 2>/dev/null || :)" = "$label" ]; then
    as_console_user /usr/bin/pluginkit -r "$legacy/Contents/PlugIns/AndroidFinderProvider.appex" || :
    as_console_user "$lsregister" -u "$legacy" || :
    backup=$(/usr/bin/mktemp -d '/Library/Application Support/Android Finder/previous.XXXXXX')
    /bin/mv "$legacy" "$backup/Android Finder.app"
fi

as_console_user "$lsregister" -f "$app" || :
as_console_user /usr/bin/pluginkit -a "$app/Contents/PlugIns/AndroidFinderProvider.appex" || :
/bin/launchctl bootstrap "$domain" "$plist" || :
